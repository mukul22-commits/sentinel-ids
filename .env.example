# Sentinel IDS Platform - root environment template (used by Docker Compose).
# Copy to .env at the repository root:  cp .env.example .env
#
# NOTE: Compose looks for .env in the compose file's directory (infra/), so
# always pass --env-file .env to read this root file:
#   docker compose --env-file .env -f infra/docker-compose.yml up -d --build
# Generate strong values before production, e.g.:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"

POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sentinel_ids
POSTGRES_PORT=5432

REDIS_PORT=6379
REDIS_PASSWORD=change-me

SECRET_KEY=change-me-in-production

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
