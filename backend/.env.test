# Sentinel IDS Platform - test environment template.
# Used by pytest. Tests in CI override DATABASE_URL/REDIS_URL to reach compose services.

APP_NAME=Sentinel IDS Platform
APP_VERSION=3.0.0
ENVIRONMENT=test

# Dedicated test database (dbname: sentinel_ids_test)
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel_ids_test

# Dedicated test Redis logical DB
REDIS_URL=redis://localhost:6379/1

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=300

REDIS_CACHE_TTL_SECONDS=300

CELERY_TASK_ALWAYS_EAGER=true
CELERY_WORKER_CONCURRENCY=2
CELERY_BEAT_SCHEDULE_ENABLED=false

TIMESCALE_CHUNK_INTERVAL_DAYS=1

CORS_ORIGINS=["http://localhost:5173"]

SECRET_KEY=test-secret-not-for-production
