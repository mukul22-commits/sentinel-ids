# Sentinel IDS Platform - backend environment template (Phase 2)
# Copy to .env to override the documented defaults. Values are read by pydantic-settings.

APP_NAME=Sentinel IDS Platform
APP_VERSION=3.0.0
ENVIRONMENT=dev
LOG_LEVEL=INFO

# PostgreSQL (asyncpg driver). In Docker Compose the host is overridden to the
# "postgres" service name; "localhost" is correct for native/local runs.
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel_ids

# Connection pool (pre_ping validates idle connections for HA; timeout waits for a free conn).
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=300
DB_POOL_PRE_PING=true
DB_POOL_TIMEOUT=10

# Redis (cache/queue for Celery). Overridden to the "redis" service in Compose.
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=300

# Celery
CELERY_TASK_ALWAYS_EAGER=false
CELERY_WORKER_CONCURRENCY=4
CELERY_BEAT_SCHEDULE_ENABLED=true
CELERY_WORKER_MAX_TASKS_PER_CHILD=200

# TimescaleDB hypertable chunking (used by Alembic migration 0001)
TIMESCALE_CHUNK_INTERVAL_DAYS=1

# Comma-free JSON list of allowed browser origins (pydantic-settings parses as JSON).
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Origin of the SPA; the OIDC callback redirects the browser here with tokens in a fragment.
FRONTEND_URL=http://localhost:5173

# Placeholder - MUST be replaced with a strong random value before production (Phase 3: auth).
SECRET_KEY=change-me-in-production

# Production hardening (Phase 7): uvicorn workers + Prometheus multiprocess dir.
UVICORN_WORKERS=1
UVICORN_GRACEFUL_TIMEOUT=30
PROMETHEUS_MULTIPROC_DIR=/tmp/sentinel-prom

# Connector plugins (Phase 7). Leave unset/blank to use the log-only fallback.
# HTTP_CONNECTOR_URL=https://firewall.example.com/webhook
# HTTP_CONNECTOR_TOKEN=change-me
HTTP_CONNECTOR_TIMEOUT_SECONDS=5
# EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USERNAME=alerting
# EMAIL_SMTP_PASSWORD=change-me
EMAIL_SMTP_USE_TLS=true
EMAIL_FROM_ADDR=sentinel-ids@localhost

# External SIEM export (Phase 7): ArcSight CEF batches to a collector endpoint.
SIEM_EXPORT_ENABLED=false
# SIEM_CEF_ENDPOINT_URL=https://siem.example.com/cef
# SIEM_AUTH_TOKEN=change-me
SIEM_BATCH_SIZE=100
SIEM_EXPORT_SECONDS=60
SIEM_HTTP_TIMEOUT_SECONDS=5

# Fleet / multi-sensor management (Phase 8): heartbeat watchdog + sensor tokens.
# Sensors authenticate with an X-Sensor-Token header and are marked offline when
# they stop heartbeating for SENSOR_STALE_AFTER_SECONDS.
SENSOR_TOKEN_BYTES=32
SENSOR_WATCHDOG_SECONDS=30
SENSOR_STALE_AFTER_SECONDS=90

# Advanced detection (Phase 9): YARA payload scanning + flow autoencoder.
YARA_DETECTOR_ENABLED=true
YARA_RULES_DIR=app/yara_rules
YARA_MAX_PAYLOAD_BYTES=1048576
AUTOENCODER_DETECTOR_ENABLED=false
ML_AE_MODEL_PATH=app/ml_models/flow_autoencoder.joblib
AUTOENCODER_THRESHOLD=1.0

# UEBA / behavioral analytics (Phase 9).
UEBA_ENABLED=true
UEBA_PROFILES_PATH=app/ueba_profiles/baselines.joblib
UEBA_WINDOW_HOURS=24
UEBA_MIN_SAMPLES=20
UEBA_THRESHOLD=3.0

# OIDC single sign-on (Phase 9). Leave OIDC_ENABLED=false for local JWT auth.
# Flow: GET /api/v1/auth/oidc/config -> /oidc/authorize (returns provider URL)
#       -> browser SSO -> callback at OIDC_REDIRECT_PATH.
OIDC_ENABLED=false
# OIDC_ISSUER=https://login.example.com/realms/sentinel
# OIDC_CLIENT_ID=sentinel-ids
# OIDC_CLIENT_SECRET=change-me
OIDC_SCOPES=openid email profile
# OIDC_DOMAIN=example.com
# OIDC_REDIRECT_PATH=/api/v1/auth/oidc/callback
# OIDC_STATE_TTL_SECONDS=600

# Secret management (Phase 9): SECRET_KEY resolution priority is
# env value -> SECRET_KEY_FILE -> Vault KV v2.
# SECRET_KEY_FILE=/run/secrets/secret_key
# VAULT_URL=https://vault.example.com:8200
# VAULT_TOKEN=change-me
VAULT_MOUNT=secret
# VAULT_PATH=sentinel/ids

# SOAR connectors (Phase 9): OPNsense firewall + EDR.
# OPNSENSE_CONNECTOR_URL=https://firewall.example.com
# OPNSENSE_CONNECTOR_KEY=change-me
# OPNSENSE_CONNECTOR_SECRET=change-me
OPNSENSE_CONNECTOR_TIMEOUT_SECONDS=5
# EDR_CONNECTOR_URL=https://edr.example.com
# EDR_CONNECTOR_TOKEN=change-me
EDR_CONNECTOR_TIMEOUT_SECONDS=5
